# Copy this file to `.env` and edit.

# true  = use fake data stored in the browser (no backend needed)
# false = talk to the real Express API
VITE_USE_MOCK=true

# Only needed when VITE_USE_MOCK=false.
# Leave as /api in dev (Vite proxies it to the backend, see vite.config.js).
# In production, set the full backend URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Where the Vite dev server proxies /api to (backend port)
VITE_BACKEND_URL=http://localhost:5000
